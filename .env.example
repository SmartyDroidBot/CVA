# CVA — Cognitive VAPT Assistant
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. All settings below are optional — the values shown
# are the built-in defaults (see src/config.py). Uncomment only what you change.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama (local, default) | openai | anthropic | google
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Cloud providers — set the matching API key to use them.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.5-flash

# ── Agent Architecture ───────────────────────────────────────────────────────
# supervisor = multi-agent routing (default) | single = one ReAct agent
# AGENT_MODE=supervisor

# ── Guardrails / Safety ──────────────────────────────────────────────────────
# GUARDRAILS_ENABLED=true          # screen user input for prompt injection
# GUARDRAIL_THRESHOLD=0.5          # block inputs scoring at/above this
# REQUIRE_APPROVAL=true            # gate dangerous shell commands before running

# ── Session / Memory ─────────────────────────────────────────────────────────
# AUTO_SESSION=true
# MAX_MESSAGES_BEFORE_SUMMARY=30
MONGO_URI=mongodb://localhost:27017
# MONGO_DB=cva

# ── Knowledge Base (RAG) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# KB_COLLECTION=cva_kb
# EMBEDDING_MODEL=nomic-embed-text

# ── UI / Debug ───────────────────────────────────────────────────────────────
DEBUG_MODE=false
SHOW_THINKING=false
SHOW_TOOL_OUTPUT=false
