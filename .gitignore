# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.pyo
*.pyd
build/
dist/
wheels/
*.egg-info/
.eggs/
*.so

# ── Virtual Environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit secrets. Copy .env.example → .env and fill in your values.
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx

# ── uv / pip ─────────────────────────────────────────────────────────────────
# uv.lock is useful to commit in applications; remove this line if you want to.
# uv.lock

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.test.log

# ── Local Data (DB volumes) ───────────────────────────────────────────────────
# MongoDB and Qdrant data directories — never commit database files.
data/mongo/
data/qdrant/
data/sources/

# ── Pentest Reports ───────────────────────────────────────────────────────────
# Generated reports contain sensitive target information.
reports/
*.report.md
*.report.html

# ── Logs & Debug Output ───────────────────────────────────────────────────────
*.log
logs/
*.out

# ── OS & Editor Cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.txt
node_modules/

# ── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore local override with secrets
docker-compose.override.yml
docker-compose.local.yml
